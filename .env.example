# ==========================================
# ОСНОВНЫЕ НАСТРОЙКИ СЕРВЕРА
# ==========================================
# Домен, на котором будет доступен сервис
DOMAIN=paste.example.com

# ==========================================
# НАСТРОЙКИ БАЗЫ ДАННЫХ (PostgreSQL)
# ==========================================
# Пароль для базы данных (ОБЯЗАТЕЛЬНО измените в production!)
DB_PASSWORD=secure_db_password_here

# (Опционально) Имя пользователя базы данных. По умолчанию: postgres
# DB_USER=postgres

# (Опционально) Имя базы данных. По умолчанию: copypaste
# DB_NAME=copypaste
